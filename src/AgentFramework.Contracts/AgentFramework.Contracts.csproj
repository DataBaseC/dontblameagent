<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AgentFramework.Contracts</RootNamespace>
    <AssemblyName>AgentFramework.Contracts</AssemblyName>
  </PropertyGroup>

  <!--
    契约程序集的设计铁律（见 DESIGN.md 4.3）：
      1. 必须由宿主「共享加载」（non-collectible，不随插件卸载）
      2. 跨边界只能用 BCL 类型 + 本程序集定义的类型
      3. 引用的第三方库要锁死版本（此处仅官方 abstractions）
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

</Project>
