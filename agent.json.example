{
  // ══════════════════════════════════════════════════════════════
  //  配置单 —— 复制成 agent.json 放在这一层，改完直接 dotnet run
  //  （也可以用 `dotnet run --project src/AgentFramework.Host -- --init-config` 生成一份）
  //
  //  所有字段都可以省略；省略的走默认值。
  //  优先级：命令行 > 环境变量 > 本文件。
  // ══════════════════════════════════════════════════════════════

  // ── 端点：填「地址 + 模型名」就算配好 ─────────────────────────
  "cloud": {
    "baseUrl": "https://api.deepseek.com/v1",
    "apiKey": "在这里填你的 key",
    "model": "deepseek-reasoner"
  },

  // 本地端点（可选）。LM Studio 默认 1234；Ollama 是 http://localhost:11434/v1
  "local": {
    "baseUrl": "http://localhost:1234/v1",
    "model": "你加载的模型名"
  },

  // 在界面里配（点顶栏「模型」）会写成下面这个新格式；
  // 上面那种 cloud / local 的老写法一样认，不用手工改。
  // 写过 providers 之后，cloud / local 会被摘掉 —— 同一件事不留两个真相。
  // "providers": [
  //   {
  //     "id": "deepseek",
  //     "name": "DeepSeek",
  //     "baseUrl": "https://api.deepseek.com/v1",
  //     "apiKeyProtected": "（DPAPI 加密后的密文；没加密能力的平台存 apiKey 明文）",
  //     "models": [{ "id": "deepseek-reasoner" }]
  //   }
  // ],
  // "active": { "providerId": "deepseek", "modelId": "deepseek-reasoner" },

  // ── 目录与界面 ───────────────────────────────────────────────
  "workspace": "agent-workspace",
  "sessions": "agent-sessions",
  "webPort": 8090,
  "mode": "work",

  // ── 其它开关（按需打开）──────────────────────────────────────
  // "includeUsage": true,      // 端点不认 stream_options 时设为 false
  // "maxSteps": 12,
  // "temperature": 0.7,
  // "context": { "tokenBudget": 24000, "compressionTriggerRatio": 0.8 }

  // ── 命令沙箱（编程必备）──────────────────────────────────────
  // auto（默认）：Windows 用 job（内核限额），其他平台用 process（进程护栏）
  //   off     = 不设护栏（排查问题时用，能一键退回「没有沙箱的世界」）
  //   process = 工作目录钉在工作区 + 临时目录重定向进工作区 +
  //             超时/取消连子孙进程一起终结 + 输出过程中封顶
  //   job     = 在 process 之上再加内存上限、CPU 时间上限、活动进程数上限，
  //             且宿主退出时连同子孙一并终结（Windows 专有，Job Object）
  // 名字不认识或平台不可用时会回落到可用档 —— 具体用了哪一档在界面状态里看得见。
  // 插件也可以注册自己的沙箱后端（如容器），写它的名字就行。
  // "sandbox": "auto"

  // ── 工具包（按需开合，降低 agent 负担）────────────────────────
  // 「装了什么」≠「这一轮给模型看什么」。把这段活用不上的包收起来：
  // 省的是每轮都要发的工具定义（30+ 个工具约 10k 字符），
  // 也让模型少在几十个工具里挑错（超过 30~50 个准确率就开始下降）。
  // 界面顶栏「包」里也能随时开合；agent 自己也会用 use_toolset 收。
  // 可选包：exec（跑命令）/ memory / search / plan / web / self，
  //         以及插件带来的包（devkit、writing-kit、mcp:<server> …）
  // core 与 meta 是保留包，写了也不生效 —— 那会把 agent 关成残废。
  // "disabledToolsets": ["writing-kit", "web"]
}
